{
  "name": "stragy",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader native && node scripts/build-server.mjs",
    "start": "node start.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:unit": "vitest run --configLoader native src/test/unit",
    "test:integration": "vitest run --configLoader native src/test/integration",
    "test:components": "vitest run --configLoader native src/test/components",
    "test:coverage": "vitest run --configLoader native --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "build:worker": "node scripts/build-server.mjs",
    "predev": "npm run build:worker"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "rollup": "npm:@rollup/wasm-node@4.64.6",
    "supertest": "7.3.1",
    "tailwindcss": "^4.1.14",
    "terser": "^5.51.2",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=26.5.0 <27",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "rollup": "$rollup"
  }
}
