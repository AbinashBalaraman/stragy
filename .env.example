# No credentials are required for the labeled offline demo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_MODE=demo
EXPOSURE_MODE=private
AI_PROVIDER=none
STORAGE_MODE=ephemeral
# Private production requires API_ACCESS_TOKEN. Never commit real values.
# External AI is optional, explicit, provider-specific, and never auto-falls back.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# SMARTAPI_API_KEY=
# SMARTAPI_CLIENT_CODE=
# SMARTAPI_PASSWORD=
# SMARTAPI_TOTP_KEY=
