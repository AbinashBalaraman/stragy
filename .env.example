# No credentials are required for the labeled offline demo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_MODE=demo
EXPOSURE_MODE=private
AI_PROVIDER=none
STORAGE_MODE=ephemeral
# Private production requires API_ACCESS_TOKEN. Never commit real values.
# External AI is optional, explicit, provider-specific, and never auto-falls back.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# SMARTAPI_API_KEY=
# SMARTAPI_CLIENT_CODE=
# SMARTAPI_PASSWORD=
# SMARTAPI_TOTP_KEY=

# Observed public daily-data research, no broker authentication required:
# EXPOSURE_MODE=public-research
# DATA_MODE=real
# MARKET_PROVIDER=yahoo
# PUBLIC_ORIGIN=https://your-existing-service.onrender.com
# MAX_JOB_MS=90000
# MAX_QUEUE=4
# Optional existing TokenRouter account, with zero-price verification before every request:
# AI_PROVIDER=tokenrouter
# AI_MODEL=stealth/union-alpha
# AI_COST_POLICY=free-only
# AI_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MAX_REQUESTS_PER_HOUR=12
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
