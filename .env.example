# No credentials are required for the labeled offline demo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_MODE=demo
EXPOSURE_MODE=private
AI_PROVIDER=none
STORAGE_MODE=ephemeral
# Private site password gate (HTTP Basic). Minimum 12 characters; never commit a value.
# SITE_USER=owner
# SITE_PASSWORD=
# Private production requires API_ACCESS_TOKEN. Never commit real values.
# External AI is optional, explicit, provider-specific, and never auto-falls back.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENCODE_API_KEY=
# SMARTAPI_API_KEY=
# SMARTAPI_CLIENT_CODE=
# SMARTAPI_PASSWORD=
# SMARTAPI_TOTP_KEY=

# Observed public daily-data research, no broker authentication required:
# EXPOSURE_MODE=public-research
# DATA_MODE=real
# MARKET_PROVIDER=yahoo
# PUBLIC_ORIGIN=https://your-existing-service.onrender.com
# MAX_JOB_MS=90000
# MAX_QUEUE=4

# Owner-only private deployment with Angel One history and quotes behind Basic auth:
# EXPOSURE_MODE=private
# DATA_MODE=real
# MARKET_PROVIDER=angel
# QUOTES_PROVIDER=angel
# SITE_USER=owner
# SITE_PASSWORD=
# ANGEL_API_KEY=
# ANGEL_CLIENT_CODE=
# ANGEL_PASSWORD=
# ANGEL_TOTP_SECRET=
# Optional existing TokenRouter account, with zero-price verification before every request:
# AI_PROVIDER=tokenrouter
# AI_MODEL=stealth/union-alpha
# AI_COST_POLICY=free-only
# AI_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MAX_REQUESTS_PER_HOUR=12
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Optional separate vision provider for chart screenshots (defaults to AI_PROVIDER/AI_MODEL):
# VISION_PROVIDER=
# VISION_MODEL=

# OpenCode Go subscription (OpenAI-compatible; fixed opencode.ai endpoint):
# AI_PROVIDER=opencode-go
# AI_MODEL=hy4-flash-free
# AI_FALLBACK_MODELS=openrouter:openrouter/free,opencode-go:deepseek-v4.1-flash
# AI_APPROVED_PAID_MODELS=opencode-go:deepseek-v4.1-flash
# AI_COST_POLICY=free-only
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# Provider settings database (Neon Postgres, pooled for the app and direct for migrations):
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Base64 32-byte AES-256-GCM key for stored provider keys. Required on Render;
# locally a data/.provider-secrets-key file is generated instead.
# PROVIDER_SECRETS_KEY=
# Free Go models: hy4-flash-free (primary; text and chart vision verified).
# Paid fallbacks must be listed in AI_APPROVED_PAID_MODELS; all other paid models
# stay blocked. openrouter/free is zero-price verified against the OpenRouter
# models endpoint before every use. Training-use contributor models are excluded.

